@@ -8,0 +9,41 @@ import { isTuziEmbeddedMode } from '../../services/tuzi-embedded-config';
+export const UKING_MANAGED_GENERATION_MESSAGE =
+  '画布已由 U-King/虾盘云管理，请使用外层生成图片';
+
+/**
+ * Kept parameterized so the URL contract can be tested without a browser.
+ * Only the explicit host flag changes the upstream BYOK behavior.
+ */
+export function isUkingHostMode(
+  search: string | undefined =
+    typeof window === 'undefined' ? undefined : window.location.search
+): boolean {
+  return new URLSearchParams(search).get('uking_host') === '1';
+}
+
+function showUkingManagedGenerationNotice(): void {
+  if (typeof document === 'undefined') return;
+
+  const existing = document.getElementById('uking-managed-generation-notice');
+  if (existing) return;
+
+  const notice = document.createElement('div');
+  notice.id = 'uking-managed-generation-notice';
+  notice.setAttribute('role', 'alert');
+  notice.textContent = UKING_MANAGED_GENERATION_MESSAGE;
+  notice.style.cssText = [
+    'position:fixed',
+    'right:24px',
+    'bottom:24px',
+    'z-index:10000',
+    'max-width:360px',
+    'padding:12px 16px',
+    'border-radius:8px',
+    'background:#fff7e6',
+    'color:#873800',
+    'box-shadow:0 4px 16px rgba(0,0,0,.18)',
+    'font:14px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif',
+  ].join(';');
+  document.body.appendChild(notice);
+  window.setTimeout(() => notice.remove(), 5000);
+}
+
