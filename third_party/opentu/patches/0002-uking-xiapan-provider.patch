+export async function applyUkingProviderCredentials(
+  apiKey: unknown
+): Promise<boolean> {
+  const normalizedApiKey =
+    typeof apiKey === 'string' ? apiKey.trim() : '';
+  if (!normalizedApiKey) return false;
+  try {
+    if (new URL(geminiSettings.get().baseUrl).origin !== 'https://api.u-claw.org.cn') {
+      return false;
+    }
+  } catch {
+    return false;
+  }
+  await geminiSettings.update({ apiKey: normalizedApiKey });
+  return true;
+}
