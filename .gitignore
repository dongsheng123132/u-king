node_modules/
dist/
dist-usb/
src-tauri/target/
src-tauri/gen/schemas/
*.log
# 网站构建产物（exe/msi 太大，发布走 deploy.sh 本地拷贝 + OSS 上传）
website/download/*.exe
website/download/*.msi
# 已发布稳定版二进制保存在 OSS/下载服务器；本地仅供 deploy.sh 上传，避免把大文件塞进 Git。
website/download/stable/
website/.vercel/
# 自检输出
*selfcheck*.json
uking-*.json
*.bak-before*

# 临时调试产物（截图 / 一次性 json / 脚本，本地保留不入库）
.tmp-*
# 本地临时工作区 + pnpm 内容寻址 store（体积大、纯本地；闸门的 SKIP_DIRS 也已认它）
.scratch/
.pnpm-store/
# 电商上架素材（淘宝/拼多多主图 + 上架方案，营销产物本地保留不入库）
ecommerce-assets/
dist-compare/
# 一次性产物：演示卸载绿色版 exe、路演 PPT、导出 outputs（本地保留不入库）
dist-demo-uninstaller/
outputs/

# 排版取证的截图产物（tools/shot-rtk.mjs 生成），只在本地看，不进仓库
tools/*.png
shots/

# 探针 / 截图跑道的残留（2026-08-21 收拾）—— 不是产物也不是源码，
# 是跑 shot-*.mjs / check-*.mjs 时落在仓库根的临时文件。留在磁盘上，别进 git。
/--json
/_after.json
/board-probe.json
/*.png
/*.jpg

# 本地工作文档：内部交接稿 / 计划 / 分享草稿，未对外公开 —— 防 `git add -A` 把它们带进公开仓。
# CLAUDE.md 也先按本地文档忽略。若要让外部贡献者也拿到它，就该显式提交它本身，
# 而不是靠「碰巧一直没被 add」——公开仓里出现什么，只应该由决定出现的东西决定。
PLAN_FIRST.md
TASK_HANDOFF_*.md
tmp-chatgpt-share.md
teamai-tencent-cloud-readonly-handoff.md
CLAUDE.md
花瑶花开-发布资料包/

# OTLP collector / replay 的运行凭据；报告和冻结数据集另行入库。
/otel-traces/
/scripts/replay/results/

# 🔴 vercel.json 是 2026-06-17 站点搬新加坡时**删掉**的死配置，CLAUDE.md 明写「别再放回去」。
# 但它在几个老 worktree 的磁盘上一直留着（未跟踪），谁跑一次 git add -A 就被当成「新增」暂存 ——
# 08-21 那两次「main 上凭空长出整体回滚」里，vercel.json +13 行就是这么来的。挡住它。
/vercel.json

# 防误加：凭据/证书/环境文件/IDE 与 OS 残留
.env
.env.*
*.pem
*.key
*.pfx
*.p12
*.crt
*.der
*.keystore
credentials*.json
token*.json
*.log.*
.DS_Store
Thumbs.db
# AI agent 在本机留下的状态（worktrees/、settings.local.json、plans/、cargo.err…）——
# 全是机器本地的东西：公开仓里不该出现，也不该被 `git add -A` 顺走。
.claude/
.hermes/
# Python 字节码缓存（scripts/*.py 被跑过就会留）
__pycache__/
*.pyc
.idea/
.vscode/
*.swp
